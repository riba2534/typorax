{
  "name": "typorax",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A free, local-first Markdown editor for macOS",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:mac": "npm run build && npm run licenses && bash scripts/build-macos.sh",
    "test": "playwright test",
    "licenses": "node scripts/licenses.mjs",
    "package:mac": "npm run build:mac && bash scripts/package-macos.sh",
    "docs:check": "node scripts/check-release.mjs",
    "verify:local": "bash scripts/verify-local.sh",
    "docs:screenshots": "npm run build && node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-task-list": "3.32.0",
    "@tiptap/extension-task-item": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-code-block-lowlight": "3.32.0",
    "@tiptap/extension-focus": "3.32.0",
    "@tiptap/extension-mathematics": "3.32.0",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/search": "6.7.2",
    "codemirror": "6.0.2",
    "katex": "0.18.10",
    "lowlight": "3.3.0",
    "mermaid": "12.2.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "@playwright/test": "1.64.1",
    "@types/katex": "0.16.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riba2534/typorax.git"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
